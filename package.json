{
  "name": "dsh-task-shelf",
  "version": "1.0.2",
  "description": "DSH 任务资料夹：把会话和下一步放在一起。社区试用版。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs/TRY-IT.md",
    "docs/screenshots/fat-fish-light.png",
    "docs/IMPLEMENTATION.md",
    "docs/TEST-RESULTS.md",
    "docs/DSH-REVIEW-RESPONSE.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.3 || 0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3 || 0.2.1-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:local": "node scripts/pack.mjs"
  }
}
